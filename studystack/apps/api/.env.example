# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studystack"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"          # access token TTL
JWT_REFRESH_EXPIRES_IN="7d"   # refresh token TTL

# ── CORS (comma-separated allowlist; unset = reflect any origin) ─────────
CORS_ORIGIN="http://localhost:3000"

# ── AI Gateway ────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
# Model tiers (llm-handling §2.1) — Gateway model strings, swap without code changes
AI_MODEL_FRONTIER="google/gemini-2.5-pro"
AI_MODEL_EMBEDDING="google/gemini-embedding-001"

# ── Redis (BullMQ + auth rate limiting) ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# Number of trusted reverse-proxy hops for req.ip behind a proxy (e.g. "1").
# Leave unset locally — trusting it without a proxy lets clients spoof IPs.
TRUST_PROXY=""

# ── Object Storage (AWS S3, virtual-hosted style) ─────────────────────────
# STORAGE_DRIVER=local keeps the legacy multipart disk flow; s3 enables
# presigned browser PUTs (POST /courses/uploads/presign → PUT → confirm).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="ap-southeast-1" # must be a real AWS region when STORAGE_DRIVER=s3
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="studystack-uploads"

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="StudyStack <onboarding@resend.dev>" # dev-only; prod = verified domain

# ── F1 upload path: bounds & ingestion pipeline (all optional) ───────────
# Every value has a safe built-in default; set only to tune for capacity.
# Upload validation (design doc §5/§6) — sizes in bytes.
UPLOAD_MAX_BYTES=52428800               # per-file cap (default 50 MB)
UPLOAD_MAX_PAGES=600                    # reject PDFs over this page count
UPLOAD_MAX_UNCOMPRESSED_BYTES=262144000 # DOCX ZIP-bomb expanded-size cap (250 MB)
UPLOAD_MAX_ARCHIVE_ENTRIES=4096         # DOCX ZIP entry-count cap
UPLOAD_MAX_COMPRESSION_RATIO=100        # per-entry expansion ratio guard
# Extraction batching + OCR guardrails (doc §17/§26).
INGEST_PAGE_BATCH=25                    # pages per extraction batch
INGEST_JOB_PAGE_BUDGET=100              # pages a job does before continuation
OCR_PAGE_TIMEOUT_MS=60000              # wall-clock per OCR page
OCR_MAX_IMAGE_PIXELS=4000000           # downscale OCR input above this
OCR_RECYCLE_AFTER_PAGES=50             # rebuild the WASM OCR worker every N
WEB_URL="http://localhost:3000" # reset link base → WEB_URL/reset-password?token=
PASSWORD_RESET_TTL="30m" # reset link TTL
