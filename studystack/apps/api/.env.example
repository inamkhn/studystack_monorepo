# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studystack"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"          # access token TTL
JWT_REFRESH_EXPIRES_IN="7d"   # refresh token TTL

# ── CORS (comma-separated allowlist; unset = reflect any origin) ─────────
CORS_ORIGIN="http://localhost:3000"

# ── AI Gateway ────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
# Model tiers (llm-handling §2.1) — Gateway model strings, swap without code changes
AI_MODEL_FRONTIER="google/gemini-2.5-pro"
AI_MODEL_EMBEDDING="google/gemini-embedding-001"

# ── Redis (BullMQ + auth rate limiting) ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# Number of trusted reverse-proxy hops for req.ip behind a proxy (e.g. "1").
# Leave unset locally — trusting it without a proxy lets clients spoof IPs.
TRUST_PROXY=""

# ── Object Storage (AWS S3, virtual-hosted style) ─────────────────────────
# STORAGE_DRIVER=local keeps the legacy multipart disk flow; s3 enables
# presigned browser PUTs (POST /courses/uploads/presign → PUT → confirm).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="ap-southeast-1" # must be a real AWS region when STORAGE_DRIVER=s3
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="studystack-uploads"

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="StudyStack <onboarding@resend.dev>" # dev-only; prod = verified domain
WEB_URL="http://localhost:3000" # reset link base → WEB_URL/reset-password?token=
PASSWORD_RESET_TTL="30m" # reset link TTL
