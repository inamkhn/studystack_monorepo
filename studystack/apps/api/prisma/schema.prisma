// StudyStack — schema.prisma
// Scope: Full spec (F1–F19). Contains all core domains (Auth, Course, Assessment,
// Mastery, QnA, Export, Certificate, Marketplace, Classroom) in a single unified schema.
//
// IMPORTANT — vector columns:
// With `extensions = [vector]` and the `postgresqlExtensions` preview
// feature, `prisma migrate dev` generates correct `vector(768)` columns
// and `CREATE EXTENSION IF NOT EXISTS vector` natively. The HNSW indexes
// are the only piece Prisma does not generate — run vector-schema.sql
// after the Prisma migration to create them, before any embedding writes.
//
// 768 dimensions assumes Gemini Embedding with Matryoshka truncation to 768 —
// confirm against whatever embedding model is finalized before first migration,
// since changing dimension later means re-embedding + re-indexing everything.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
  // Prisma 7: the legacy prisma-client-js generator emits into
  // node_modules/.prisma, which pnpm's isolated layout cannot resolve —
  // the new generator emits into the project instead.
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  student
  teacher
  creator
  admin
}

enum AgeBracket {
  adult
  minor_school_consented
  unknown // default for unresolved self-serve accounts — never defaults to adult
}

// Closed enum per Feature 18 ("explain-it-your-way", not free text).
// PLACEHOLDER VALUES — confirm the actual persona list against the Feature 18
// spec before migrating; these are illustrative only, not sourced from it.
enum ExplanationStyle {
  neutral
  sports
  pop_culture
  historical
  cooking
  sci_fi
}

enum ConceptMatchStatus {
  confident
  pending_review
  resolved
}

enum CourseSourceType {
  upload
  topic
}

enum CourseStatus {
  intake_pending
  ingesting
  structuring
  ready
  failed
}

enum Goal {
  class
  exam_prep
  curiosity
}

enum Level {
  beginner
  some_background
}

enum CourseVisibility {
  private
  public_shared
}

enum LicenseStatus {
  user_uploaded_unknown
  open_license
}

enum ContentProvenance {
  reused_from_upload
  reused_from_topic_research
  generated
}

enum ConceptReviewStatus {
  pending_review
  resolved_merged
  dismissed
}

enum QuizAttemptType {
  module_quiz
  final_project
  practice_problem
}

enum CertificateCourseType {
  ai_generated
  instructor_verified
}

enum MarketplaceReviewStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(student)
  ageBracket       AgeBracket        @default(unknown)
  explanationStyle ExplanationStyle?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  coursesOwned         Course[]                 @relation("CourseOwner")
  resolvedReviewsAdmin ConceptReviewCandidate[] @relation("ReviewResolvedBy")
  courseForks          CourseFork[]             @relation("ForkedBy")
  courseReports        CourseReport[]           @relation("CourseReporter")
  quizAttempts         QuizAttempt[]            @relation("QuizStudent")
  masteryScores        MasteryScore[]           @relation("MasteryStudent")
  subtopicCompletions  SubtopicCompletion[]     @relation("CompletionStudent")
  moduleQuizzes        ModuleQuiz[]             @relation("QuizOwner")
  qnaMessages          QnaMessage[]             @relation("QnaStudent")
  certificates         Certificate[]            @relation("CertificateStudent")
  purchases            Purchase[]               @relation("PurchaseBuyer")
  marketplaceCourses         MarketplaceReviewQueue[] @relation("MarketplaceCreator")
  assignedMarketplaceReviews MarketplaceReviewQueue[] @relation("MarketplaceReviewer")
  classroomsTaught           Classroom[]              @relation("ClassroomTeacher")
  classroomsEnrolled         ClassroomStudent[]       @relation("ClassroomStudentRelation")
  refreshTokens              RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Course — F1, F2, F3
// ─────────────────────────────────────────────────────────────────────────

model Course {
  id         String           @id @default(uuid())
  ownerId    String
  owner      User             @relation("CourseOwner", fields: [ownerId], references: [id])
  sourceType CourseSourceType
  topic      String?
  title      String
  status     CourseStatus     @default(intake_pending)
  // F1 failure contract: human-readable reason when status = failed.
  failureReason String?
  // F1 progress reporting: current ingestion stage
  // (queued → extracting → chunking → embedding) for the status endpoint.
  ingestionStage String?
  // F1 §2.3: detected source language (BCP-47 code, e.g. "en", "de", "zh").
  // Generated content stays in the source's language by default.
  language       String?

  goal           Goal?
  level          Level?
  levelChangedAt DateTime?
  examDate       DateTime?

  visibility           CourseVisibility @default(private)
  publishedAt          DateTime?
  publishGateCheckedAt DateTime?
  publishAttestationAt DateTime?

  description      String?
  price            Float?
  creatorPayoutPct Float?
  stripeProductId  String?
  stripePriceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceDocuments SourceDocument[]
  sourceChunks    SourceChunk[]
  modules         Module[]
  courseForks        CourseFork[]
  courseReports      CourseReport[]
  certificates       Certificate[]
  purchases          Purchase[]
  marketplaceReviews MarketplaceReviewQueue[]
  classrooms         Classroom[]
  exports            Export[]
  finalProject       FinalProject?

  @@map("courses")
}

// ─────────────────────────────────────────────────────────────────────────
// Ingestion / source material — F1
// ─────────────────────────────────────────────────────────────────────────

model SourceDocument {
  id               String        @id @default(uuid())
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id])
  fileUrl          String?
  sourceUrl        String?
  fileType         String?
  // F1: upload size in bytes, surfaced in ingestion progress.
  fileSizeBytes    Int?
  // F1 §4.4: SHA-256 of the uploaded bytes — duplicate-upload detection.
  contentHash      String?
  extractionStatus String?
  licenseStatus    LicenseStatus @default(user_uploaded_unknown)
  uploadedAt       DateTime      @default(now())

  sourceChunks SourceChunk[]

  @@index([contentHash])
  @@map("source_documents")
}

model SourceChunk {
  id               String         @id @default(uuid())
  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id])
  chunkText        String
  metadata         Json
  needsResearchFill Boolean       @default(false)
  embedding        Unsupported("vector(768)")?
  createdAt        DateTime       @default(now())

  @@index([courseId])
  @@map("source_chunks")
}

// ─────────────────────────────────────────────────────────────────────────
// Course structure — F4
// ─────────────────────────────────────────────────────────────────────────

model Module {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  order    Int
  title    String
  createdAt DateTime @default(now())

  subtopics    Subtopic[]
  quizAttempts QuizAttempt[]
  quizzes      ModuleQuiz[]

  @@index([courseId])
  @@map("modules")
}

model Subtopic {
  id                      String  @id @default(uuid())
  moduleId                String
  module                  Module  @relation(fields: [moduleId], references: [id])
  order                   Int
  title                   String
  // F12 — auto calc-heavy flag, set once at module-generation time (F4);
  // practiceProblemsOverride takes precedence when non-null.
  calcHeavy               Boolean @default(false)
  practiceProblemsOverride Boolean?
  createdAt               DateTime @default(now())

  tutorialContent  TutorialContent[]
  subtopicConcepts SubtopicConcept[]
  practiceProblems PracticeProblem[]
  qnaMessages      QnaMessage[]
  completions      SubtopicCompletion[]

  @@index([moduleId])
  @@map("subtopics")
}

// ─────────────────────────────────────────────────────────────────────────
// Canonical concepts — F4 (concept resolution)
// ─────────────────────────────────────────────────────────────────────────

model Concept {
  id            String   @id @default(uuid())
  canonicalName String
  subjectArea   String
  aliases       String[]
  embedding     Unsupported("vector(768)")?
  createdAt     DateTime @default(now())
  matchStatus   ConceptMatchStatus @default(confident)
  mergedIntoId  String?
  mergedInto    Concept?  @relation("ConceptMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Concept[] @relation("ConceptMerge")

  subtopicConcepts       SubtopicConcept[]
  reviewCandidatesAsNew  ConceptReviewCandidate[] @relation("CandidateConcept")
  reviewCandidatesAsBase ConceptReviewCandidate[] @relation("MatchedConcept")
  quizAttempts           QuizAttempt[]
  masteryScores          MasteryScore[]
  conceptReviewContents  ConceptReviewContent[]

  @@map("concepts")
}

model SubtopicConcept {
  subtopicId String
  subtopic   Subtopic @relation(fields: [subtopicId], references: [id])
  conceptId  String
  concept    Concept  @relation(fields: [conceptId], references: [id])

  @@id([subtopicId, conceptId])
  @@map("subtopic_concepts")
}

model ConceptReviewCandidate {
  id                 String              @id @default(uuid())
  candidateConceptId String
  candidateConcept   Concept             @relation("CandidateConcept", fields: [candidateConceptId], references: [id])
  matchedConceptId   String
  matchedConcept     Concept             @relation("MatchedConcept", fields: [matchedConceptId], references: [id])
  similarityScore    Float
  status             ConceptReviewStatus @default(pending_review)
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedBy         User?               @relation("ReviewResolvedBy", fields: [resolvedByUserId], references: [id])

  @@map("concept_review_candidates")
}

// ─────────────────────────────────────────────────────────────────────────
// Subtopic tutorials — F5, F6
// ─────────────────────────────────────────────────────────────────────────

model TutorialContent {
  id         String   @id @default(uuid())
  subtopicId String
  subtopic   Subtopic @relation(fields: [subtopicId], references: [id])

  level       Level
  styleBucket String @default("neutral")

  explanation      Json
  diagramSpec      Json?
  imageSource      Json?
  example          Json?
  resourceDecision Json?

  provenance ContentProvenance
  generatedAt DateTime @default(now())

  @@unique([subtopicId, level, styleBucket])
  @@map("tutorial_content")
}

// ─────────────────────────────────────────────────────────────────────────
// Course Forks & Reports — F14, F19
// ─────────────────────────────────────────────────────────────────────────

model CourseFork {
  id               String   @id @default(uuid())
  originalCourseId String
  originalCourse   Course   @relation(fields: [originalCourseId], references: [id])
  studentId        String
  student          User     @relation("ForkedBy", fields: [studentId], references: [id])
  createdAt        DateTime @default(now())

  classroomStudents ClassroomStudent[]
  quizAttempts      QuizAttempt[]

  @@unique([originalCourseId, studentId])
  @@map("course_forks")
}

model CourseReport {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  reporterId String
  reporter   User     @relation("CourseReporter", fields: [reporterId], references: [id])
  reason     String
  createdAt  DateTime @default(now())

  @@map("course_reports")
}

// ─────────────────────────────────────────────────────────────────────────
// Assessment & Mastery — F7, F8, F9, F11, F12
// ─────────────────────────────────────────────────────────────────────────

model QuizAttempt {
  id         String          @id @default(uuid())
  studentId  String
  student    User            @relation("QuizStudent", fields: [studentId], references: [id])
  moduleId   String
  module     Module          @relation(fields: [moduleId], references: [id])
  conceptId  String?
  concept    Concept?        @relation(fields: [conceptId], references: [id])
  forkId     String?
  courseFork CourseFork?     @relation(fields: [forkId], references: [id])
  type       QuizAttemptType @default(module_quiz)
  question   String
  answer     String
  rationale  String?
  correct    Boolean
  timestamp  DateTime        @default(now())

  // F19 dashboard joins via classroom_students.fork_id → course_forks.id;
  // per-student history queries use studentId.
  @@index([studentId])
  @@index([forkId])
  @@map("quiz_attempts")
}

model MasteryScore {
  studentId      String
  student        User     @relation("MasteryStudent", fields: [studentId], references: [id])
  conceptId      String
  concept        Concept  @relation(fields: [conceptId], references: [id])
  score          Float
  lastReviewedAt DateTime @default(now())
  nextReviewAt   DateTime

  @@id([studentId, conceptId])
  // F15 cross-course overlap checks and F19 concept-set filtering query by conceptId.
  @@index([conceptId])
  @@map("mastery_scores")
}

model ConceptReviewContent {
  id           String   @id @default(uuid())
  conceptId    String
  concept      Concept  @relation(fields: [conceptId], references: [id])
  level        Level
  angleVariant Int
  explanation  String
  generatedAt  DateTime @default(now())

  @@unique([conceptId, level, angleVariant])
  @@map("concept_review_content")
}

model PracticeProblem {
  id          String   @id @default(uuid())
  subtopicId  String
  subtopic    Subtopic @relation(fields: [subtopicId], references: [id])
  problemText String
  hintsJson   Json
  solution    String

  @@map("practice_problems")
}

// ─────────────────────────────────────────────────────────────────────────
// In-Tutorial Q&A — F10
// ─────────────────────────────────────────────────────────────────────────

model QnaMessage {
  id         String   @id @default(uuid())
  subtopicId String
  subtopic   Subtopic @relation(fields: [subtopicId], references: [id])
  studentId  String
  student    User     @relation("QnaStudent", fields: [studentId], references: [id])
  question   String
  answer     String
  // F10 semantic cache — embedding on the question, scoped to subtopicId,
  // powers the near-duplicate-question check before any LLM call.
  embedding  Unsupported("vector(768)")?
  timestamp  DateTime @default(now())

  @@map("qna_messages")
}

// ─────────────────────────────────────────────────────────────────────────
// Export — F13
// ─────────────────────────────────────────────────────────────────────────

model Export {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  format      String    // pdf | docx | markdown
  status      String    @default("pending") // pending | generating | completed | failed
  fileUrl     String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("exports")
}

// ─────────────────────────────────────────────────────────────────────────
// Certificates — F16
// ─────────────────────────────────────────────────────────────────────────

model Certificate {
  id               String                @id @default(uuid())
  studentId        String
  student          User                  @relation("CertificateStudent", fields: [studentId], references: [id])
  courseId         String
  course           Course                @relation(fields: [courseId], references: [id])
  issuedAt         DateTime              @default(now())
  verificationSlug String                @unique
  courseType       CertificateCourseType

  @@unique([studentId, courseId])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────────────
// Marketplace — F17
// ─────────────────────────────────────────────────────────────────────────

model Purchase {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  buyerId   String
  buyer     User     @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  amount    Float
  timestamp DateTime @default(now())

  @@map("purchases")
}

model MarketplaceReviewQueue {
  id                       String                  @id @default(uuid())
  courseId                 String
  course                   Course                  @relation(fields: [courseId], references: [id])
  creatorId                String
  creator                  User                    @relation("MarketplaceCreator", fields: [creatorId], references: [id])
  submittedAt              DateTime                @default(now())
  slaDueAt                 DateTime
  status                   MarketplaceReviewStatus @default(pending)
  assignedReviewerId       String?
  assignedReviewer         User?                   @relation("MarketplaceReviewer", fields: [assignedReviewerId], references: [id])
  copyrightChecklistPassed Boolean

  @@map("marketplace_review_queue")
}

// ─────────────────────────────────────────────────────────────────────────
// Classroom Mode — F19
// ─────────────────────────────────────────────────────────────────────────

model Classroom {
  id                 String             @id @default(uuid())
  teacherId          String
  teacher            User               @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  courseId           String
  course             Course             @relation(fields: [courseId], references: [id])
  consentOnFile      Boolean            @default(false)
  consentDocumentUrl String?
  inviteCode         String?            @unique
  students           ClassroomStudent[]

  @@map("classrooms")
}

model ClassroomStudent {
  classroomId String
  classroom   Classroom   @relation(fields: [classroomId], references: [id])
  studentId   String
  student     User        @relation("ClassroomStudentRelation", fields: [studentId], references: [id])
  forkId      String?
  fork        CourseFork? @relation(fields: [forkId], references: [id])
  joinedAt    DateTime    @default(now())

  @@id([classroomId, studentId])
  @@map("classroom_students")
}

// ─────────────────────────────────────────────────────────────────────────
// Assessment support — F7, F9
// ─────────────────────────────────────────────────────────────────────────

// Client-driven "mark complete" record (F7 submit gate + F9 last-module gate).
// One row per (student, subtopic); idempotent upsert via PATCH /subtopics/:id/complete.
model SubtopicCompletion {
  studentId   String
  student     User      @relation("CompletionStudent", fields: [studentId], references: [id])
  subtopicId  String
  subtopic    Subtopic  @relation(fields: [subtopicId], references: [id])
  completedAt DateTime  @default(now())

  @@id([studentId, subtopicId])
  @@index([subtopicId])
  @@map("subtopic_completions")
}

// Per-student generated module quiz — the handoff between gated GET and submit.
// Regenerated on every GET (per-student generation decision); the row lets submit
// grade server-side against the exact questions the student answered.
// `questions` Json: [{ id, type: "recall"|"applied", prompt, conceptId,
//                     answerKey? (recall), rubric? (applied) }] — answerKey/rubric
// are stripped before questions are returned to the client.
model ModuleQuiz {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation("QuizOwner", fields: [studentId], references: [id])
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id])
  questions   Json
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([studentId, moduleId])
  @@map("module_quizzes")
}

// Generated final-project prompt, one per course (generated on first GET,
// served from here on later GETs). Submissions still land in `quiz_attempts`
// with type = final_project — this row only holds the prompt itself.
model FinalProject {
  id        String   @id @default(uuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id])
  prompt    String
  createdAt DateTime @default(now())

  @@map("final_projects")
}
