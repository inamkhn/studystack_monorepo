# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studystack"

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

# ── CORS (comma-separated allowlist; unset = reflect any origin) ─────────
CORS_ORIGIN="http://localhost:3000"

# ── AI Gateway ────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"

# ── Redis (BullMQ) ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Object Storage (S3-compatible) ────────────────────────────────────────
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="studystack-uploads"

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── PostHog ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# ── Sentry ────────────────────────────────────────────────────────────────
SENTRY_DSN=""
